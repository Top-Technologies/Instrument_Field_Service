<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_instrument_field_service_register_list" model="ir.ui.view">
        <field name="name">instrument.field.service.register.list</field>
        <field name="model">instrument.field.service.register</field>
        <field name="arch" type="xml">
            <list string="Instrument Register" default_order="delivery_date desc, register_no">
                <field name="register_no" optional="show"/>
                <field name="customer_name"/>
                <field name="product_id"/>
                <field name="serial_number"/>
                <field name="site_city" optional="show"/>
                <field name="delivery_date" optional="show"/>
                <field name="delivery_status"/>
                <field name="installation_status"/>
                <field name="sso_training_status"/>
                <field name="calibration_status" optional="hide"/>
                <field name="installation_fse_fas" optional="hide"/>
                <field name="last_updated" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_instrument_field_service_register_form" model="ir.ui.view">
        <field name="name">instrument.field.service.register.form</field>
        <field name="model">instrument.field.service.register</field>
        <field name="arch" type="xml">
            <form string="Instrument Field Service Register">
                <sheet>
                    <group>
                        <group string="Instrument">
                            <field name="register_no"/>
                            <field name="product_id" options="{'no_create': True}"/>
                            <field name="serial_number"/>
                            <field name="block_serial_number"/>
                            <field name="heated_cover_serial_number"/>
                            <field name="region"/>
                            <field name="zone"/>
                            <field name="customer_name" string="Customer Name"/>
                            <field name="customer_contact_number"/>
                            <field name="site_city"/>
                        </group>
                        <group string="Delivery">
                            <field name="delivery_status"/>
                            <field name="delivery_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installation">
                            <group>
                                <field name="installation_status"/>
                                <field name="installation_date"/>
                                <field name="installer_name"/>
                                <field name="installation_fse_fas"/>
                            </group>
                            <group string="Installation Documents">
                                <field name="installation_checklist_complete"/>
                                <field name="installation_checklist_document" filename="installation_checklist_filename"
                                       widget="binary" string="Installation Checklist Document"/>
                                <field name="installation_checklist_filename" invisible="1"/>
                                <field name="iq_oq_ipv_complete"/>
                                <field name="iq_oq_ipv_document" filename="iq_oq_ipv_filename" widget="binary"
                                       string="IQ/OQ/IPV Documentation"/>
                                <field name="iq_oq_ipv_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="SSO Training">
                            <group>
                                <field name="sso_training_status"/>
                                <field name="sso_training_date"/>
                                <field name="trainer_name"/>
                            </group>
                            <group string="Training Participants" col="4">
                                <field name="training_participant_ids" colspan="4" nolabel="1">
                                    <list editable="bottom">
                                        <control>
                                            <create string="Add a line"/>
                                        </control>
                                        <field name="participant_name"/>
                                        <field name="role_or_organization" optional="show"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Calibration and Notes">
                            <group>
                                <field name="calibration_status"/>
                                <field name="last_calibration_date"/>
                                <field name="next_calibration_date"/>
                                <field name="last_updated"/>
                            </group>
                            <group string="Remarks / Next Action" col="4">
                                <field name="remarks_next_action" colspan="4" nolabel="1" widget="text"
                                       placeholder="Add remarks or the next action"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_instrument_field_service_register_search" model="ir.ui.view">
        <field name="name">instrument.field.service.register.search</field>
        <field name="model">instrument.field.service.register</field>
        <field name="arch" type="xml">
            <search string="Search Instrument Register">
                <field name="customer_name"/>
                <field name="serial_number"/>
                <field name="product_id"/>
                <field name="site_city"/>
                <filter name="delivery_pending" string="Delivery Pending" domain="[('delivery_status', '=', 'pending')]"/>
                <filter name="installation_pending" string="Installation Pending" domain="[('installation_status', '=', 'pending')]"/>
                <filter name="training_pending" string="SSO Training Pending" domain="[('sso_training_status', '=', 'pending')]"/>
                <separator/>
                <filter name="group_by_city" string="Site / City" context="{'group_by': 'site_city'}"/>
                <filter name="group_by_model" string="Instrument Model" context="{'group_by': 'product_id'}"/>
                <filter name="group_by_installation" string="Installation Status" context="{'group_by': 'installation_status'}"/>
                <filter name="group_by_training" string="SSO Training Status" context="{'group_by': 'sso_training_status'}"/>
                <filter name="group_by_delivery" string="Delivery Status" context="{'group_by': 'delivery_status'}"/>
                <filter name="group_by_calibration" string="Calibration Status" context="{'group_by': 'calibration_status'}"/>
            </search>
        </field>
    </record>

    <record id="view_instrument_field_service_register_graph" model="ir.ui.view">
        <field name="name">instrument.field.service.register.graph</field>
        <field name="model">instrument.field.service.register</field>
        <field name="arch" type="xml">
            <graph string="Instrument Service Status" type="bar">
                <field name="installation_status"/>
                <field name="record_count" type="measure" string="Records"/>
            </graph>
        </field>
    </record>

    <record id="view_instrument_field_service_register_pivot" model="ir.ui.view">
        <field name="name">instrument.field.service.register.pivot</field>
        <field name="model">instrument.field.service.register</field>
        <field name="arch" type="xml">
            <pivot string="Instrument Service Report" display_quantity="1">
                <field name="site_city" type="row"/>
                <field name="product_id" type="row"/>
                <field name="installation_status" type="col"/>
                <field name="record_count" type="measure" string="Records"/>
            </pivot>
        </field>
    </record>

    <record id="action_instrument_field_service_register" model="ir.actions.act_window">
        <field name="name">Instrument Register</field>
        <field name="res_model">instrument.field.service.register</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_instrument_field_service_register_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an instrument register entry</p>
            <p>Track delivery, installation, SSO training, calibration, and next actions.</p>
        </field>
    </record>

    <record id="action_instrument_field_service_reporting" model="ir.actions.act_window">
        <field name="name">Instrument Register Reporting</field>
        <field name="res_model">instrument.field.service.register</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_instrument_field_service_register_search"/>
    </record>

    <menuitem id="menu_instrument_field_service_register" name="Instrument Register"
              parent="industry_fsm.fsm_menu_root" action="action_instrument_field_service_register" sequence="60"/>
    <menuitem id="menu_instrument_field_service_reporting" name="Instrument Register Reporting"
              parent="industry_fsm.fsm_menu_reporting" action="action_instrument_field_service_reporting" sequence="70"/>

    <record id="view_project_task_form_field_service_maintenance" model="ir.ui.view">
        <field name="name">project.task.form.field.service.maintenance</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="industry_fsm.view_task_form2_inherit"/>
        <field name="priority">1010</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="required">0</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Maintenance Register" name="field_service_maintenance_details"
                      invisible="not is_field_service_task">
                    <field name="is_field_service_task" invisible="True"/>
                    <group>
                        <group string="Customer">
                            <field name="customer_contact_number" placeholder="Optional"/>
                        </group>
                        <group string="Maintenance">
                            <field name="distance_travelled"/>
                            <field name="actual_maintenance_date"/>
                        </group>
                    </group>
                    <group string="Spare Parts" col="4">
                        <field name="spare_parts_used"/>
                        <field name="spare_part_line_ids" colspan="4" nolabel="1"
                               invisible="not spare_parts_used">
                            <list editable="bottom">
                                <control>
                                    <create string="Add a line"/>
                                </control>
                                <field name="sequence" widget="handle" optional="hide"/>
                                <field name="part_name"/>
                                <field name="part_number"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="project_task_view_list_fsm_inherit_optional_customer" model="ir.ui.view">
        <field name="name">project.task.list.fsm.inherit.optional.customer</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="industry_fsm.project_task_view_list_fsm"/>
        <field name="priority">1010</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="required">0</attribute>
            </field>
        </field>
    </record>

    <record id="quick_create_task_form_fsm_inherit_optional_customer" model="ir.ui.view">
        <field name="name">project.task.form.quick_create.inherit.optional.customer</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="industry_fsm.quick_create_task_form_fsm"/>
        <field name="priority">1010</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="required">0</attribute>
            </field>
        </field>
    </record>

    <record id="project_task_view_mobile_form_inherit_optional_customer" model="ir.ui.view">
        <field name="name">fsm.task.form.view.mobile.inherit.optional.customer</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="industry_fsm.project_task_view_mobile_form"/>
        <field name="priority">1010</field>
        <field name="arch" type="xml">
            <field name="partner_id" position="attributes">
                <attribute name="required">0</attribute>
            </field>
        </field>
    </record>
</odoo>
